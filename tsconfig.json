{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"lib": ["DOM", "ES2019"],
		"moduleResolution": "bundler",
		"strict": true,
		"target": "ES6",
		"module": "ES6",
		"skipLibCheck": true,
		"sourceMap": false,
		"outDir": "dist",
		"declaration": true,
		"declarationDir": "dist"
	},
	"include": ["src/index.ts"],
	"exclude": ["node_modules"]
}
